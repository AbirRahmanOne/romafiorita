# Backend (FastAPI) environment — copy to .env for local dev. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://romafiorita:romafiorita@localhost:5432/romafiorita
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array). Storefront + admin + localhost dev.
CORS_ORIGINS=["https://romafiorita.com","https://admin.romafiorita.com","http://localhost:3000"]

# Secrets — placeholders, set real values locally / in Render.
JWT_SECRET=dev-only-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
