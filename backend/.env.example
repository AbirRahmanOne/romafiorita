# Backend (FastAPI) environment — copy to .env for local dev. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://romafiorita:romafiorita@localhost:5432/romafiorita
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array). Storefront + admin + localhost dev.
CORS_ORIGINS=["https://romafiorita.com","https://admin.romafiorita.com","http://localhost:3000"]

# Secrets — placeholders, set real values locally / in Render.
# JWT_SECRET must be a real 32+ byte value outside development (startup fails otherwise).
JWT_SECRET=dev-only-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Auth / cookies.
# COOKIE_DOMAIN: leave unset in dev (host-only cookies); set .romafiorita.com in prod.
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_BYTES=1000000
